SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Needed for the deep-link buttons on the "Save & Done" finalize message
# (📱 Open in mini-app, ✏️ Edit, View visit on the manager broadcast).
# Match the bot service's values exactly — same names. Without
# TELEGRAM_BOT_USERNAME the buttons silently disappear.
TELEGRAM_BOT_USERNAME=your-bot-username-without-the-at-sign
TELEGRAM_MINIAPP_SHORT_NAME=miniapp
# Optional — fallback if sva.settings.broadcast_chat_id is unset.
BROADCAST_CHAT_ID=
