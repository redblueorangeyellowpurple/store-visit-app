SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional — needed for the deep-link buttons on the "Save & Done" finalize
# message (📱 Open in mini-app, ✏️ Edit, View visit on the manager broadcast).
# Match the bot service's values. If absent the message still sends, just
# without those buttons.
TELEGRAM_BOT_USERNAME=your-bot-username-without-the-at-sign
TELEGRAM_MINIAPP_SHORTNAME=your-mini-app-short-name
# Optional — fallback if sva.settings.broadcast_chat_id is unset.
BROADCAST_CHAT_ID=
