# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=random-secret-string
# Bot @username (no @) — used to build miniapp deep links for visit broadcasts
TELEGRAM_BOT_USERNAME=
# Mini App short name configured in BotFather (defaults to "miniapp")
TELEGRAM_MINIAPP_SHORT_NAME=miniapp
# Chat ID of the group that receives "✅ {CM} visited {store}" broadcasts on visit lock
BROADCAST_CHAT_ID=
# Optional: separate chat for join-request approvals. Falls back to BROADCAST_CHAT_ID if unset.
JOIN_REQUEST_CHAT_ID=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Railway
WEBHOOK_DOMAIN=https://your-app.up.railway.app
PORT=3000

# Claude API — required for /runintelligence + daily cron
ANTHROPIC_API_KEY=

# Dashboard base URL — used to build the "View full brief" inline button on
# the daily intelligence Telegram message. Example: https://sva-dashboard.up.railway.app
DASHBOARD_URL=

# Daily intelligence cron (set on Railway prod only — keep unset locally)
#   true  → bot fires `runDailyIntelligenceFlow` on schedule
#   unset → no cron is registered (default for dev)
INTELLIGENCE_CRON_ENABLED=
# Optional override; default "0 23 * * *" UTC = 07:00 SGT
INTELLIGENCE_CRON_SCHEDULE=

# Morning cron (set on Railway prod only — keep unset locally)
#   true  → bot fires 08:00 preview-to-Wilson + 09:00 team send on schedule
#   unset → no morning cron is registered (default for dev)
MORNING_CRON_ENABLED=
# Optional cron override for the 08:00 Wilson preview (default = "0 0 * * *" UTC = 08:00 SGT)
MORNING_PREVIEW_SCHEDULE=
# Optional cron override for the 09:00 team send (default = "0 1 * * *" UTC = 09:00 SGT)
MORNING_SEND_SCHEDULE=

# Email (Phase 6 — leave empty until needed)
RESEND_API_KEY=

# ── Intel inbox (LOCAL-ONLY tool — never set these on Railway) ──
# Dedicated BotFather bot for forwarding promoter store updates into
# promotchi.intel_updates. Runs on Wilson's Mac via `npm run inbox`.
INTEL_BOT_TOKEN=
# Telegram user allowed to use the inbox (defaults to Wilson)
INTEL_OWNER_ID=806982232
